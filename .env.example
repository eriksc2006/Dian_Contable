# Copie este archivo a .env y complete los valores.
# Nunca hardcodee credenciales en el código.

APP_ENV=development
LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.80

# Identidad de auditoría (también se puede definir en la UI)
AUDITOR_DEFAULT_NAME=contador

# Cuentas contables por defecto (software contable)
CUENTA_CXC=130505
CUENTA_CXP=220505
CUENTA_IVA_GENERADO=24080501
CUENTA_IVA_DESCONTABLE=24081001
CUENTA_INGRESO_DEFAULT=41355602
CUENTA_COMPRA_DEFAULT=613501
CUENTA_COSTO_DEFAULT=613502
CENTRO_COSTO_DEFAULT=00

# Comprobante inicial (5 dígitos)
COMPROBANTE_INICIAL=1

# Fase 2 — automatización DIAN (opcional). Dejar vacío en el MVP.
DIAN_BASE_URL=
DIAN_USERNAME=
DIAN_PASSWORD=
DIAN_HEADLESS=true
